# ── Local development environment ────────────────────────────────────────
# Copy these into your terminal with `export` (see docs/DEVELOPMENT.md).
# In production these come from Kubernetes secrets/config, NOT this file.

# Database (point at a local MySQL/MariaDB — e.g. the Docker one in DEVELOPMENT.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=define_dev

# Signs the login cookie. Any long random string for local dev.
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@define-cleaning.dk
SEED_ADMIN_PASSWORD=Admin1234

# Optional — CRM forwarding (leave unset locally; bookings still work)
# CRM_INTERNAL_URL=
# CRM_INTERNAL_SECRET=
# CRM_CUSTOMER_SLUG=rengoeringdk

# Contact forms: provision both keys and exact hostnames to activate Turnstile.
# Blank keys leave Turnstile inactive; honeypots still apply.
# TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated bare hostnames, e.g. example.dk,www.example.dk
TURNSTILE_HOSTNAMES=
# Explicit provider: altcha, cap, turnstile, or none. Unset preserves legacy settings.
# Each customer/environment/contact surface requires an independent site key.
# CONTACT_SPAM_PROVIDER=altcha
ALTCHA_SITE_KEY=
ALTCHA_SECRET_KEY=
# Server-only origin, e.g. http://altcha.contact-altcha.svc.cluster.local:3001
ALTCHA_VERIFY_BASE_URL=
# Browser-reachable HTTPS origin, e.g. https://altcha.scaledev.dk
ALTCHA_PUBLIC_BASE_URL=

# Optional compatible self-hosted Cap provider.
CAP_SITE_KEY=
CAP_SECRET_KEY=
CAP_VERIFY_BASE_URL=
CAP_PUBLIC_BASE_URL=
